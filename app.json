{
  "expo": {
    "name": "بيعلي – Bi3li",
    "slug": "bi3li",
    "scheme": "bi3li",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Bi3li a besoin de vos photos pour les ajouter à vos annonces. / يحتاج بيعلي إلى صورك لإضافتها إلى إعلاناتك.",
          "cameraPermission": "Bi3li a besoin de l’appareil photo pour photographier vos articles. / يحتاج بيعلي إلى الكاميرا لتصوير سلعك."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0B6B3A",
          "defaultChannel": "default"
        }
      ]
    ],
    "android": {
      "package": "net.bi3li.twa",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "ios": {
      "bundleIdentifier": "net.bi3li.app",
      "supportsTablet": false
    },
    "extra": {
      "apiUrl": "https://bi3li.net",
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "536f30df-ef1a-485d-a9e0-0f409191e78c"
      }
    },
    "web": {
      "output": "single",
      "bundler": "metro",
      "favicon": "./assets/icon.png",
      "name": "بيعلي – Bi3li"
    },
    "experiments": {
      "baseUrl": "/app"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/536f30df-ef1a-485d-a9e0-0f409191e78c"
    },
    "owner": "bi3li-apps-team"
  }
}
